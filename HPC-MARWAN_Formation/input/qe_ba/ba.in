 &CONTROL
  calculation = 'scf' ,
  outdir='.',
  prefix='calc',
  pseudo_dir='.',
  forc_conv_thr = 0.01,
  etot_conv_thr = 1d-06,
   verbosity='high'
 /
 &SYSTEM
                       ibrav = 1,
                   celldm(1) = 7.899054632,
                         nat = 5,
                        ntyp = 3,
                     ecutwfc = 50 ,
                     ecutrho = 190 ,
                 occupations = 'tetrahedra' ,
                     degauss = 0.02 ,
                    smearing = 'gaussian' ,
                       nspin = 1 ,
   
 /
 &ELECTRONS
                    conv_thr = 1.0d-8 ,
                 mixing_beta = 0.7 ,
             diagonalization = 'david' ,
            electron_maxstep=200
 /
