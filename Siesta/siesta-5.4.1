lancement du job 
 

vi run_siesta_h2.sl

#!/bin/bash
#SBATCH --job-name=siesta_h2
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=00:10:00
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

module purge
module use /home/a.belkziz/.local/easybuild/modules/all
module load Siesta/5.4.1-gompi-2023a

mpirun -np 1 siesta < h2.fdf > h2.out

